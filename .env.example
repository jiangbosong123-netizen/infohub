# 复制为 .env 后按需修改。不配 LLM 也能跑（纯聚合模式，无摘要/评分/日报 AI 章节）。

# LLM：任何 OpenAI 兼容接口。智谱 GLM 示例（https://open.bigmodel.cn）：
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=

# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# OpenAI 示例：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- 调度 ---
CRAWL_TICK_MINUTES=5
RECONCILE_HOUR=6
RECONCILE_MINUTE=30
REPORT_HOUR=8
REPORT_MINUTE=0

# --- 其他 ---
# 仅本机访问保持 127.0.0.1；Windows 服务器供 Tailscale 设备访问时改为 0.0.0.0。
WEB_HOST=127.0.0.1
PORT=8000
SEC_USER_AGENT=personal-news-aggregator admin@example.com
