# 复制为 .env 后按需修改。不配 LLM 也能跑（纯聚合模式，无摘要/评分/日报 AI 章节）。

# --- 运行环境与数据安全 ---
# Docker Compose 会显式注入 production、Windows 数据路径和三个进程角色。
# Mac 直接运行时默认使用隔离的 .runtime/development-local/，并关闭所有网络任务。
# 只有确实要从 Mac 手动抓取时才把角色设为 maintenance 并开启网络；不要让 Mac 与
# Windows 同时充当生产采集器。
# INFOHUB_ENVIRONMENT=development
INFOHUB_PROCESS_ROLE=web
INFOHUB_ALLOW_NETWORK_TASKS=false
INFOHUB_ENABLE_SCHEDULER=false
# Mac 单进程开发保持 false；生产 Compose 会对三个角色显式设为 true。
INFOHUB_DURABLE_JOBS_ENABLED=false
INFOHUB_CURATED_FEED_ENABLED=true
# 门户读取 P13c 版本化策展发布结果；默认关闭，待导入和验收后再单独开启。
INFOHUB_CURATION_READ_ENABLED=false
INFOHUB_CURATION_SEARCH_ENABLED=false
INFOHUB_CURATION_HOT_ENABLED=false
# 版本化主题统计构建任务；完成审核覆盖与发布验收前保持 false。
INFOHUB_TOPIC_STATISTICS_ENABLED=false
# 门户主题页读取已批准的版本化统计；与后台构建分开，默认关闭。
INFOHUB_TOPIC_READ_ENABLED=false
# 版本化日报的读取与定时写入分开开启；写入要求读取也为 true。
INFOHUB_REPORT_READ_ENABLED=false
INFOHUB_REPORT_WRITE_ENABLED=false
# P18 类型化目录 API；完成数据与契约验收前保持 false。
INFOHUB_API_CATALOG_ENABLED=false
# 稳定文档 API；默认关闭。
INFOHUB_API_ITEMS_ENABLED=false
# 只读取通过 event-release-v1 发布门的事件；默认关闭。
INFOHUB_API_EVENTS_ENABLED=false
# 经过验证并正式发布的不可变分析结果；默认关闭。
INFOHUB_API_ANALYSES_ENABLED=false
# 文档输入与原始记录的脱敏证据读取；默认关闭。
INFOHUB_API_EVIDENCE_ENABLED=false
# Bounded immutable sync snapshots. Keep disabled until the public ledger is populated.
INFOHUB_API_SYNC_ENABLED=false
# INFOHUB_ENVIRONMENT_ID=mac-development
# INFOHUB_DB_PATH=/absolute/path/to/development/app.db
# INFOHUB_BLOB_PATH=/absolute/path/to/development/blobs
# INFOHUB_BACKUP_PATH=/absolute/path/to/development/backups
# INFOHUB_RUNTIME_PATH=/absolute/path/to/development/runtime

# LLM：任何 OpenAI 兼容接口。智谱 GLM 示例（https://open.bigmodel.cn）：
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.6
LLM_API_KEY=

# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# OpenAI 示例：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- 调度 ---
CRAWL_TICK_MINUTES=5
AI_TICK_MINUTES=15
RECONCILE_HOUR=6
RECONCILE_MINUTE=30
REPORT_HOUR=8
REPORT_MINUTE=0
# Nightly backup bundle (worker). Keeps the newest BACKUP_KEEP bundles in backups/nightly and the newest
# BACKUP_KEEP_PRE_MIGRATION upgrade copies in backups/pre-migration; refuses to start without
# database + evidence + BACKUP_RESERVE_MB of free space.
BACKUP_HOUR=3
BACKUP_MINUTE=30
BACKUP_KEEP=3
BACKUP_KEEP_PRE_MIGRATION=2
BACKUP_RESERVE_MB=2048
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_HEARTBEAT_TTL_SECONDS=45
WORKER_HEARTBEAT_FUTURE_TOLERANCE_SECONDS=5
WORKER_LEASE_SECONDS=300
PIPELINE_JOB_STALE_SECONDS=900
RAW_PAYLOAD_MAX_BYTES=2097152

# --- 其他 ---
# 直接运行开发服务时保持 127.0.0.1。生产容器内部由 Compose 覆盖为 0.0.0.0，
# 但宿主机发布端口固定绑定 127.0.0.1，再由 Tailscale Serve 提供私网 HTTPS。
WEB_HOST=127.0.0.1
PORT=8000

# 生产 Windows 由 Tailscale Serve 提供私网 HTTPS；填写 Serve 输出的完整 origin。
# 示例：https://windows-server.example-tailnet.ts.net（不要加端口或路径）
INFOHUB_PUBLIC_ORIGIN=
# 机器外的心跳报警（可选）：在 Healthchecks、Uptime Kuma 等服务建一个“推送”检查，周期 5 分钟、宽限约 20 分钟，
# 选好通知渠道后把它的 https 推送地址填在这里。worker 每完成一轮抓取访问一次；停机、断网或卡死时由该服务通知。
# 该地址等同密钥，不会出现在日志或 runtime-config 输出里。
# INFOHUB_EXTERNAL_HEARTBEAT_URL=
SEC_USER_AGENT=personal-news-aggregator admin@example.com
